# Flask Application Environment Configuration Template
# Copy this file to '.env' and fill in your actual local credentials.
# NEVER commit the actual '.env' file to Git/GitHub!

# Flask Security Secret Key (Generate a random 32-character string in production)
SECRET_KEY=super-secret-dev-key-change-in-production-2026

# Flask Environment mode (development / production)
FLASK_ENV=development
FLASK_DEBUG=1

# MySQL Database Connection Details
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_budget_db

# Default Currency Symbol (e.g. ₹, $, €, £)
DEFAULT_CURRENCY=₹
